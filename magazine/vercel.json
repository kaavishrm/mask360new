{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pip3 install pillow && node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/carousels/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
